# Example environment variables for Vite frontend
# Replace <LAN_IP> with your development machine's LAN IP (e.g., 192.168.1.42)
VITE_API_BASE_URL=http://<LAN_IP>:8001

# Notes:
# - Vite exposes env vars prefixed with VITE_ to the client via import.meta.env
# - After editing .env, restart the dev server: npm run dev -- --host
